{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_notes.py\" --hook",
            "statusMessage": "ノートのルールを検証中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_notes.py\" --hook",
            "statusMessage": "変更したノートを検証中"
          }
        ]
      }
    ]
  }
}
